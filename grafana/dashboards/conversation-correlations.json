      },
      "pluginVersion": "10.4.2",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "conversation-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH filtered AS (SELECT * FROM conversation_metrics s WHERE $__timeFilter(s.updated_at) AND s.status IN (${status:sqlstring}) AND EXISTS (SELECT 1 FROM llm_calls c WHERE c.conv_id = s.conv_id AND c.model IN (${model:sqlstring}))) SELECT 'Input ↔ output' AS relationship, COALESCE(CORR(total_input_tokens::double precision, total_output_tokens::double precision), 0) AS coefficient FROM filtered UNION ALL SELECT 'Tokens ↔ cost', COALESCE(CORR(total_tokens::double precision, total_cost_usd::double precision), 0) FROM filtered UNION ALL SELECT 'Calls ↔ duration', COALESCE(CORR(total_calls::double precision, total_duration_ms::double precision), 0) FROM filtered UNION ALL SELECT 'Calls ↔ tokens', COALESCE(CORR(total_calls::double precision, total_tokens::double precision), 0) FROM filtered UNION ALL SELECT 'Duration ↔ cost', COALESCE(CORR(total_duration_ms::double precision, total_cost_usd::double precision), 0) FROM filtered",
          "refId": "A"
        }
      ],
      "title": "Correlation strength",
      "type": "barchart"
    },
