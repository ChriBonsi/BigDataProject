      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "conversation-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT conv_id AS \"Conversation\", status AS \"Status\", total_calls AS \"Calls\", total_tokens AS \"Tokens\", total_cost_usd::double precision AS \"Cost\", cost_per_1k_tokens AS \"Cost / 1k tokens\", avg_duration_ms_per_call AS \"Average duration / call\", models_used AS \"Models\", created_at AS \"Created at\", updated_at AS \"Last updated\" FROM conversation_metrics s WHERE $__timeFilter(s.updated_at) AND s.status IN (${status:sqlstring}) AND EXISTS (SELECT 1 FROM llm_calls c WHERE c.conv_id = s.conv_id AND c.model IN (${model:sqlstring})) ORDER BY cost_per_1k_tokens DESC NULLS LAST LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Conversations and efficiency outliers",
      "type": "table"
    }
