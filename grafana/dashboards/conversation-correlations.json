          "rawSql": "SELECT total_tokens::double precision AS \"Total tokens\", total_cost_usd::double precision AS \"Cost (USD)\" FROM conversation_metrics s WHERE $__timeFilter(s.updated_at) AND s.status IN (${status:sqlstring}) AND EXISTS (SELECT 1 FROM llm_calls c WHERE c.conv_id = s.conv_id AND c.model IN (${model:sqlstring})) ORDER BY total_tokens",
